PORT=8787
HOST=127.0.0.1
DATABASE_PATH=./data.sqlite
XAI_API_KEY=replace_me
XAI_MODEL=grok-3-mini
X_CLIENT_ID=replace_with_x_oauth2_client_id
# Optional. Leave empty for a public OAuth client using PKCE.
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:8787/auth/x/callback
X_SCOPES=tweet.read tweet.write users.read offline.access
# Official X API base; verify current endpoint in X developer docs.
X_API_BASE_URL=https://api.x.com/2
# Comma-separated allowed browser origins. For unpacked extension, add its chrome-extension:// origin if needed.
ALLOWED_ORIGINS=
